# FastAPI on AWS Lambda through the Lambda Web Adapter. One image serves two functions:
# the API (function URL, response streaming) and the SQS worker (WORKER_MODE=true, events passed to /internal/sqs).
FROM ghcr.io/astral-sh/uv:0.9.18 AS uv
FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adapter

FROM python:3.12-slim-bookworm
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH=/app/.venv/bin:$PATH
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
# Lambda's filesystem is read-only outside /tmp, so the embedding model ships inside the image.
ENV MODEL_DIR=/opt/models
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/models')" \
    && chmod -R a+rX /opt/models
COPY backend/app ./app
ENV DATA_DIR=/tmp/finder-keeper \
    AWS_LWA_PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/health \
    AWS_LWA_INVOKE_MODE=response_stream
CMD ["uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8080"]
