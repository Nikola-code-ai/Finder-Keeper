# LOCAL DEFAULTS: no cloud account, API key, or subscription required.
# Copy to .env. scripts/dev.sh loads these values for both services.
APP_ENV=development
AUTH_MODE=local
STORAGE_BACKEND=local
DATABASE_URL=
# DATA_DIR is optional; default is this project's backend/.data.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
GEMINI_MODEL=
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
SEED_LIBRARY=true
MAX_UPLOAD_MB=25
MAX_PAGES=1000
MAX_DOCUMENTS=500
MAX_JOBS_PER_HOUR=30
BACKEND_PORT=8010
API_INTERNAL_URL=http://127.0.0.1:8010
CLOUD_RUN_PROXY_AUTH=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional scholarly discovery credentials. Do not commit your real .env.
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
CONTACT_EMAIL=

# Optional future GCP deployment. Leave empty locally.
GOOGLE_CLOUD_PROJECT=
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=
TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=
WORKER_URL=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
